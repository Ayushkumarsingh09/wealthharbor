---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
const normalizedBase = basePath.replace(/\/$/, '');

function pageHref(page: number): string {
  return page === 1 ? normalizedBase : `${normalizedBase}?page=${page}`;
}
---

{totalPages > 1 && (
  <nav class="mt-10 flex items-center justify-center gap-2" aria-label="Pagination">
    {currentPage > 1 ? (
      <a href={pageHref(currentPage - 1)} class="btn-secondary text-sm px-4 py-2" rel="prev">← Previous</a>
    ) : (
      <span class="btn-secondary text-sm px-4 py-2 opacity-40 pointer-events-none" aria-disabled="true">← Previous</span>
    )}

    <div class="flex items-center gap-1">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        page === currentPage ? (
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-sm font-semibold text-white" aria-current="page">{page}</span>
        ) : (
          <a href={pageHref(page)} class="flex h-10 w-10 items-center justify-center rounded-lg text-sm font-medium text-surface-800 hover:bg-surface-100">{page}</a>
        )
      ))}
    </div>

    {currentPage < totalPages ? (
      <a href={pageHref(currentPage + 1)} class="btn-secondary text-sm px-4 py-2" rel="next">Next →</a>
    ) : (
      <span class="btn-secondary text-sm px-4 py-2 opacity-40 pointer-events-none" aria-disabled="true">Next →</span>
    )}
  </nav>
)}
