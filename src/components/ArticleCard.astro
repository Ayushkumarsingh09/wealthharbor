---
import { formatDate } from '@/utils/seo';
import type { CollectionEntry } from 'astro:content';
import { getCategoryBySlug } from '@/data/categories';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, category, publishedAt, readingTime, image, imageAlt } = article.data;
const categoryData = getCategoryBySlug(category);
---

<article class="card group h-full flex flex-col">
  <a href={`/articles/${article.slug}`} class="block overflow-hidden rounded-lg -mx-2 -mt-2 mb-4 aspect-video bg-surface-200">
    <img
      src={image}
      alt={imageAlt}
      width="400"
      height="225"
      class="w-full h-full object-cover transition-transform group-hover:scale-105"
      loading="lazy"
    />
  </a>
  <div class="flex-1 flex flex-col">
    <div class="flex items-center gap-2 text-xs text-surface-800 mb-2">
      <a href={`/category/${category}`} class="font-medium text-brand-600 hover:underline">
        {categoryData?.name}
      </a>
      <span>·</span>
      <span>{readingTime} min</span>
    </div>
    <h3 class="text-lg font-bold text-surface-900 mb-2 group-hover:text-brand-600 transition-colors">
      <a href={`/articles/${article.slug}`}>{title}</a>
    </h3>
    <p class="text-sm text-surface-800 line-clamp-2 flex-1">{description}</p>
    <time datetime={publishedAt.toISOString()} class="mt-3 text-xs text-surface-300">
      {formatDate(publishedAt)}
    </time>
  </div>
</article>
