---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'What is EMI?', answer: 'EMI (Equated Monthly Installment) is a fixed payment made by a borrower to a lender on a specified date each month. It includes both principal and interest components.' },
  { question: 'How does loan tenure affect EMI?', answer: 'Longer tenures reduce monthly EMI but increase total interest paid. Shorter tenures mean higher EMIs but lower overall interest cost.' },
  { question: 'Can I prepay my loan to reduce EMI?', answer: 'Prepaying reduces outstanding principal, which can lower future interest. Some lenders allow EMI recalculation after prepayment; others shorten the loan tenure instead.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="emi-principal" class="block text-sm font-medium text-surface-800 mb-1.5">Loan Amount ($)</label>
        <input type="number" id="emi-principal" value="250000" min="0" step="1000" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="emi-rate" class="block text-sm font-medium text-surface-800 mb-1.5">Annual Interest Rate (%)</label>
        <input type="number" id="emi-rate" value="7.5" min="0" max="30" step="0.1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="emi-tenure" class="block text-sm font-medium text-surface-800 mb-1.5">Loan Tenure (Years)</label>
        <input type="number" id="emi-tenure" value="20" min="1" max="40" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4" role="region" aria-live="polite" aria-label="EMI calculation results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Monthly EMI</p>
        <p id="emi-monthly" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Total Interest</p>
        <p id="emi-interest" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Total Payment</p>
        <p id="emi-total" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, emiCalculation, totalLoanInterest } from '@/utils/finance';

  const ids = ['emi-principal', 'emi-rate', 'emi-tenure'];

  function calc() {
    const principal = parseFloat((document.getElementById('emi-principal') as HTMLInputElement)?.value) || 0;
    const rate = parseFloat((document.getElementById('emi-rate') as HTMLInputElement)?.value) || 0;
    const years = parseFloat((document.getElementById('emi-tenure') as HTMLInputElement)?.value) || 0;
    const months = years * 12;
    const emi = emiCalculation(principal, rate, months);
    const interest = totalLoanInterest(principal, rate, months);
    (document.getElementById('emi-monthly') as HTMLElement).textContent = formatCurrency(emi);
    (document.getElementById('emi-interest') as HTMLElement).textContent = formatCurrency(interest);
    (document.getElementById('emi-total') as HTMLElement).textContent = formatCurrency(principal + interest);
  }

  calc();
  ids.forEach((id) => document.getElementById(id)?.addEventListener('input', calc));
</script>
