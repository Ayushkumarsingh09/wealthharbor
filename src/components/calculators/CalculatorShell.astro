---
import FAQSection from '@/components/FAQSection.astro';
import type { Calculator } from '@/data/calculators';

interface Props {
  calculator: Calculator;
  faqs: Array<{ question: string; answer: string }>;
}

const { calculator, faqs } = Astro.props;
---

<div class="space-y-8">
  <div class="card" data-calculator={calculator.slug}>
    <slot name="calculator" />
  </div>

  <section class="card" aria-labelledby="formula-heading">
    <h2 id="formula-heading" class="text-xl font-bold text-surface-900 mb-4">Formula Used</h2>
    <div class="rounded-lg bg-surface-50 border border-surface-200 px-4 py-3 font-mono text-sm text-brand-800 overflow-x-auto" role="math" aria-label="Calculator formula">
      {calculator.formula}
    </div>
    <p class="mt-3 text-surface-800 leading-relaxed">{calculator.formulaExplanation}</p>
  </section>

  <FAQSection faqs={faqs} title={`${calculator.name} — FAQ`} />

  <section class="prose-content" aria-labelledby="seo-content-heading">
    <h2 id="seo-content-heading">About the {calculator.name}</h2>
    <p>{calculator.description}</p>
    <p>
      Use this free {calculator.name.toLowerCase()} to model scenarios instantly. Adjust inputs to see how
      rate changes, time horizon, and contribution levels affect your results. All calculations run in your
      browser — no data is stored or transmitted.
    </p>
    <slot name="seo" />
  </section>
</div>
