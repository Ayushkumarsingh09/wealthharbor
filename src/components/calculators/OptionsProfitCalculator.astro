---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'How is options profit calculated?', answer: 'For calls, profit at expiry is max(0, stock price − strike) minus premium paid, multiplied by 100 shares per contract. Puts use max(0, strike − stock price) minus premium.' },
  { question: 'What is the breakeven for a call option?', answer: 'A long call breaks even at strike price + premium paid per share. The stock must rise above this level for the trade to be profitable at expiration.' },
  { question: 'Do options profits include time value before expiry?', answer: 'This calculator models profit at expiration (intrinsic value only). Before expiry, options also have time value that affects their market price.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="opt-type" class="block text-sm font-medium text-surface-800 mb-1.5">Option Type</label>
        <select id="opt-type" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" aria-label="Option type">
          <option value="call">Call</option>
          <option value="put">Put</option>
        </select>
      </div>
      <div>
        <label for="opt-strike" class="block text-sm font-medium text-surface-800 mb-1.5">Strike Price ($)</label>
        <input type="number" id="opt-strike" value="100" min="0" step="0.5" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="opt-premium" class="block text-sm font-medium text-surface-800 mb-1.5">Premium Paid ($/share)</label>
        <input type="number" id="opt-premium" value="3.50" min="0" step="0.05" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="opt-stock" class="block text-sm font-medium text-surface-800 mb-1.5">Stock Price at Expiry ($)</label>
        <input type="number" id="opt-stock" value="110" min="0" step="0.5" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="opt-contracts" class="block text-sm font-medium text-surface-800 mb-1.5">Number of Contracts</label>
        <input type="number" id="opt-contracts" value="1" min="1" max="100" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4" role="region" aria-live="polite" aria-label="Options profit results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Profit / Loss</p>
        <p id="opt-pnl" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Breakeven Price</p>
        <p id="opt-breakeven" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Total Premium Paid</p>
        <p id="opt-cost" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, optionsProfit } from '@/utils/finance';

  const ids = ['opt-type', 'opt-strike', 'opt-premium', 'opt-stock', 'opt-contracts'];

  function calc() {
    const type = (document.getElementById('opt-type') as HTMLSelectElement)?.value as 'call' | 'put';
    const strike = parseFloat((document.getElementById('opt-strike') as HTMLInputElement)?.value) || 0;
    const premium = parseFloat((document.getElementById('opt-premium') as HTMLInputElement)?.value) || 0;
    const stock = parseFloat((document.getElementById('opt-stock') as HTMLInputElement)?.value) || 0;
    const contracts = parseInt((document.getElementById('opt-contracts') as HTMLInputElement)?.value) || 1;
    const pnl = optionsProfit(type, strike, premium, stock, contracts);
    const breakeven = type === 'call' ? strike + premium : strike - premium;
    const cost = premium * 100 * contracts;
    const pnlEl = document.getElementById('opt-pnl') as HTMLElement;
    pnlEl.textContent = formatCurrency(pnl);
    pnlEl.className = `text-xl font-bold ${pnl >= 0 ? 'text-green-700' : 'text-red-700'}`;
    (document.getElementById('opt-breakeven') as HTMLElement).textContent = formatCurrency(breakeven);
    (document.getElementById('opt-cost') as HTMLElement).textContent = formatCurrency(cost);
  }

  calc();
  ids.forEach((id) => {
    const el = document.getElementById(id);
    el?.addEventListener('input', calc);
    el?.addEventListener('change', calc);
  });
</script>
