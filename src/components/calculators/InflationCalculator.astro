---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'How does inflation affect purchasing power?', answer: 'Inflation erodes the real value of money over time. $100 today buys less in the future. At 3% inflation, prices roughly double every 24 years.' },
  { question: 'What is a good inflation rate to use?', answer: 'Historical U.S. inflation has averaged around 3% annually over the long term. For conservative planning, use 3–4%. Periods of high inflation may require higher assumptions.' },
  { question: 'How do I protect against inflation?', answer: 'Invest in assets that historically outpace inflation — equities, real estate, TIPS (Treasury Inflation-Protected Securities), and I Bonds. Cash and fixed-rate bonds lose purchasing power during inflation.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="inf-amount" class="block text-sm font-medium text-surface-800 mb-1.5">Amount Today ($)</label>
        <input type="number" id="inf-amount" value="10000" min="0" step="100" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="inf-rate" class="block text-sm font-medium text-surface-800 mb-1.5">Annual Inflation Rate (%)</label>
        <input type="number" id="inf-rate" value="3" min="0" max="20" step="0.1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="inf-years" class="block text-sm font-medium text-surface-800 mb-1.5">Years in the Future</label>
        <input type="number" id="inf-years" value="20" min="1" max="50" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4" role="region" aria-live="polite" aria-label="Inflation calculation results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Future Nominal Value</p>
        <p id="inf-future" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Purchasing Power Lost</p>
        <p id="inf-lost" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Equivalent Today (Real Value)</p>
        <p id="inf-real" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, inflationAdjusted } from '@/utils/finance';

  const ids = ['inf-amount', 'inf-rate', 'inf-years'];

  function calc() {
    const amount = parseFloat((document.getElementById('inf-amount') as HTMLInputElement)?.value) || 0;
    const rate = parseFloat((document.getElementById('inf-rate') as HTMLInputElement)?.value) || 0;
    const years = parseFloat((document.getElementById('inf-years') as HTMLInputElement)?.value) || 0;
    const future = inflationAdjusted(amount, rate, years);
    const realValue = amount;
    const lost = future - amount;
    (document.getElementById('inf-future') as HTMLElement).textContent = formatCurrency(future);
    (document.getElementById('inf-lost') as HTMLElement).textContent = formatCurrency(lost);
    (document.getElementById('inf-real') as HTMLElement).textContent = formatCurrency(realValue);
  }

  calc();
  ids.forEach((id) => document.getElementById(id)?.addEventListener('input', calc));
</script>
