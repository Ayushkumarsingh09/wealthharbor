---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'When is lumpsum investing better than SIP?', answer: 'Lumpsum investing can outperform SIP when markets are at lows or in sustained bull runs. However, timing the market is difficult, which is why many investors prefer systematic investing.' },
  { question: 'How does compounding affect lumpsum returns?', answer: 'With lumpsum investing, your entire principal compounds from day one. Longer holding periods dramatically increase the effect of compounding on total returns.' },
  { question: 'Should I invest a windfall all at once?', answer: 'Research suggests that investing a windfall immediately historically outperforms spreading it over time on average, but spreading investments (dollar-cost averaging) reduces timing risk and emotional stress.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="ls-amount" class="block text-sm font-medium text-surface-800 mb-1.5">Investment Amount ($)</label>
        <input type="number" id="ls-amount" value="10000" min="0" step="100" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ls-rate" class="block text-sm font-medium text-surface-800 mb-1.5">Expected Annual Return (%)</label>
        <input type="number" id="ls-rate" value="10" min="0" max="50" step="0.1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ls-years" class="block text-sm font-medium text-surface-800 mb-1.5">Investment Period (Years)</label>
        <input type="number" id="ls-years" value="10" min="1" max="50" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4" role="region" aria-live="polite" aria-label="Lumpsum calculation results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Initial Investment</p>
        <p id="ls-principal" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Wealth Gained</p>
        <p id="ls-gain" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Maturity Value</p>
        <p id="ls-fv" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, futureValue } from '@/utils/finance';

  const ids = ['ls-amount', 'ls-rate', 'ls-years'];

  function calc() {
    const amount = parseFloat((document.getElementById('ls-amount') as HTMLInputElement)?.value) || 0;
    const rate = parseFloat((document.getElementById('ls-rate') as HTMLInputElement)?.value) || 0;
    const years = parseFloat((document.getElementById('ls-years') as HTMLInputElement)?.value) || 0;
    const fv = futureValue(amount, rate, years);
    (document.getElementById('ls-principal') as HTMLElement).textContent = formatCurrency(amount);
    (document.getElementById('ls-gain') as HTMLElement).textContent = formatCurrency(fv - amount);
    (document.getElementById('ls-fv') as HTMLElement).textContent = formatCurrency(fv);
  }

  calc();
  ids.forEach((id) => document.getElementById(id)?.addEventListener('input', calc));
</script>
