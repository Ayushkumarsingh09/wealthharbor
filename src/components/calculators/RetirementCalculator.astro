---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'How much do I need to retire?', answer: 'A common rule of thumb is 25 times your expected annual expenses (the 4% rule). This calculator projects your corpus based on savings and contributions — compare it to your estimated retirement spending needs.' },
  { question: 'What rate of return should I assume for retirement?', answer: 'Conservative planners use 5–7% for a balanced portfolio after inflation. Younger investors with more equities might model 7–10% nominally, but always stress-test with lower returns.' },
  { question: 'When should I start saving for retirement?', answer: 'The earlier you start, the more time compounding works in your favor. Even small contributions in your 20s can grow substantially by retirement age due to decades of compound growth.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="ret-savings" class="block text-sm font-medium text-surface-800 mb-1.5">Current Savings ($)</label>
        <input type="number" id="ret-savings" value="50000" min="0" step="1000" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ret-monthly" class="block text-sm font-medium text-surface-800 mb-1.5">Monthly Contribution ($)</label>
        <input type="number" id="ret-monthly" value="1000" min="0" step="50" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ret-rate" class="block text-sm font-medium text-surface-800 mb-1.5">Expected Annual Return (%)</label>
        <input type="number" id="ret-rate" value="7" min="0" max="20" step="0.1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ret-years" class="block text-sm font-medium text-surface-800 mb-1.5">Years Until Retirement</label>
        <input type="number" id="ret-years" value="25" min="1" max="50" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ret-withdraw" class="block text-sm font-medium text-surface-800 mb-1.5">Desired Monthly Income in Retirement ($)</label>
        <input type="number" id="ret-withdraw" value="5000" min="0" step="100" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" aria-describedby="ret-withdraw-hint" />
        <p id="ret-withdraw-hint" class="mt-1 text-xs text-surface-500">Used to estimate if corpus meets the 4% rule</p>
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="region" aria-live="polite" aria-label="Retirement calculation results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Projected Corpus</p>
        <p id="ret-corpus" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">From Current Savings</p>
        <p id="ret-from-savings" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">From Contributions</p>
        <p id="ret-from-contrib" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Sustainable Monthly (4% Rule)</p>
        <p id="ret-sustainable" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
    <p id="ret-status" class="mt-4 text-sm font-medium" aria-live="polite"></p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, retirementCorpus } from '@/utils/finance';

  const ids = ['ret-savings', 'ret-monthly', 'ret-rate', 'ret-years', 'ret-withdraw'];

  function calc() {
    const savings = parseFloat((document.getElementById('ret-savings') as HTMLInputElement)?.value) || 0;
    const monthly = parseFloat((document.getElementById('ret-monthly') as HTMLInputElement)?.value) || 0;
    const rate = parseFloat((document.getElementById('ret-rate') as HTMLInputElement)?.value) || 0;
    const years = parseFloat((document.getElementById('ret-years') as HTMLInputElement)?.value) || 0;
    const desired = parseFloat((document.getElementById('ret-withdraw') as HTMLInputElement)?.value) || 0;
    const { total, fromSavings, fromContributions } = retirementCorpus(savings, monthly, rate, years);
    const sustainable = (total * 0.04) / 12;
    (document.getElementById('ret-corpus') as HTMLElement).textContent = formatCurrency(total);
    (document.getElementById('ret-from-savings') as HTMLElement).textContent = formatCurrency(fromSavings);
    (document.getElementById('ret-from-contrib') as HTMLElement).textContent = formatCurrency(fromContributions);
    (document.getElementById('ret-sustainable') as HTMLElement).textContent = formatCurrency(sustainable);
    const status = document.getElementById('ret-status') as HTMLElement;
    if (desired > 0) {
      status.textContent = sustainable >= desired
        ? 'Your projected corpus may support your desired retirement income (based on the 4% rule).'
        : `Gap: you may need ${formatCurrency(desired - sustainable)} more per month or additional savings.`;
      status.className = `mt-4 text-sm font-medium ${sustainable >= desired ? 'text-green-700' : 'text-amber-700'}`;
    } else {
      status.textContent = '';
    }
  }

  calc();
  ids.forEach((id) => document.getElementById(id)?.addEventListener('input', calc));
</script>
