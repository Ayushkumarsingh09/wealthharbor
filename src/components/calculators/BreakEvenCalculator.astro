---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'What is a break-even point?', answer: 'The break-even point is where total revenue equals total costs — you neither profit nor lose. For investments, it is the price needed to recover your cost basis.' },
  { question: 'How is break-even used in trading?', answer: 'Traders calculate break-even to know the minimum price move needed to cover commissions and fees. Add per-share costs to your purchase price to find your true break-even.' },
  { question: 'What if variable costs exceed price?', answer: 'If variable cost per unit is greater than or equal to selling price, you cannot break even regardless of volume. You must raise prices or reduce variable costs.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <fieldset class="mb-4">
      <legend class="text-sm font-semibold text-surface-900 mb-3">Calculation Mode</legend>
      <div class="flex flex-wrap gap-4">
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="radio" name="be-mode" value="business" checked class="text-brand-600" aria-label="Business break-even mode" />
          <span class="text-sm text-surface-800">Business (Units)</span>
        </label>
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="radio" name="be-mode" value="investment" class="text-brand-600" aria-label="Investment break-even mode" />
          <span class="text-sm text-surface-800">Investment (Price)</span>
        </label>
      </div>
    </fieldset>

    <div id="be-business" class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="be-fixed" class="block text-sm font-medium text-surface-800 mb-1.5">Fixed Costs ($)</label>
        <input type="number" id="be-fixed" value="10000" min="0" step="100" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="be-price" class="block text-sm font-medium text-surface-800 mb-1.5">Price Per Unit ($)</label>
        <input type="number" id="be-price" value="50" min="0" step="0.01" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="be-variable" class="block text-sm font-medium text-surface-800 mb-1.5">Variable Cost Per Unit ($)</label>
        <input type="number" id="be-variable" value="30" min="0" step="0.01" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
    </div>

    <div id="be-investment" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="be-shares" class="block text-sm font-medium text-surface-800 mb-1.5">Number of Shares</label>
        <input type="number" id="be-shares" value="100" min="1" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="be-purchase" class="block text-sm font-medium text-surface-800 mb-1.5">Purchase Price ($/share)</label>
        <input type="number" id="be-purchase" value="45" min="0" step="0.01" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="be-fees" class="block text-sm font-medium text-surface-800 mb-1.5">Fees & Commissions ($)</label>
        <input type="number" id="be-fees" value="10" min="0" step="0.01" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4" role="region" aria-live="polite" aria-label="Break even results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p id="be-label" class="text-sm text-surface-600">Break-Even Units</p>
        <p id="be-result" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Contribution Margin</p>
        <p id="be-margin" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatNumber, breakEvenUnits, investmentBreakEven } from '@/utils/finance';

  function getMode() {
    return (document.querySelector('input[name="be-mode"]:checked') as HTMLInputElement)?.value || 'business';
  }

  function toggleMode() {
    const mode = getMode();
    document.getElementById('be-business')?.classList.toggle('hidden', mode !== 'business');
    document.getElementById('be-investment')?.classList.toggle('hidden', mode !== 'investment');
    document.getElementById('be-business')?.classList.toggle('grid', mode === 'business');
    document.getElementById('be-investment')?.classList.toggle('grid', mode === 'investment');
    calc();
  }

  function calc() {
    const mode = getMode();
    const label = document.getElementById('be-label') as HTMLElement;
    const result = document.getElementById('be-result') as HTMLElement;
    const margin = document.getElementById('be-margin') as HTMLElement;

    if (mode === 'business') {
      const fixed = parseFloat((document.getElementById('be-fixed') as HTMLInputElement)?.value) || 0;
      const price = parseFloat((document.getElementById('be-price') as HTMLInputElement)?.value) || 0;
      const variable = parseFloat((document.getElementById('be-variable') as HTMLInputElement)?.value) || 0;
      const units = breakEvenUnits(fixed, price, variable);
      const contrib = price - variable;
      label.textContent = 'Break-Even Units';
      result.textContent = contrib > 0 ? formatNumber(units, 0) : 'N/A';
      margin.textContent = formatCurrency(contrib);
    } else {
      const shares = parseFloat((document.getElementById('be-shares') as HTMLInputElement)?.value) || 0;
      const purchase = parseFloat((document.getElementById('be-purchase') as HTMLInputElement)?.value) || 0;
      const fees = parseFloat((document.getElementById('be-fees') as HTMLInputElement)?.value) || 0;
      const bePrice = investmentBreakEven(shares, purchase, fees);
      label.textContent = 'Break-Even Price';
      result.textContent = formatCurrency(bePrice);
      margin.textContent = formatCurrency(bePrice - purchase);
    }
  }

  toggleMode();
  document.querySelectorAll('input[name="be-mode"]').forEach((el) => el.addEventListener('change', toggleMode));
  ['be-fixed', 'be-price', 'be-variable', 'be-shares', 'be-purchase', 'be-fees'].forEach((id) =>
    document.getElementById(id)?.addEventListener('input', calc)
  );
</script>
