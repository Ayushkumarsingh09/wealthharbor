---
import CalculatorShell from './CalculatorShell.astro';
import type { Calculator } from '@/data/calculators';

interface Props { calculator: Calculator; }
const { calculator } = Astro.props;

const faqs = [
  { question: 'What is compound interest?', answer: 'Compound interest is interest calculated on both the initial principal and accumulated interest from previous periods. It causes wealth to grow exponentially over time.' },
  { question: 'How does compounding frequency matter?', answer: 'More frequent compounding (daily vs. annually) yields slightly higher returns. The difference is most pronounced at higher rates and longer time horizons.' },
  { question: 'What is the Rule of 72?', answer: 'Divide 72 by the annual interest rate to estimate how many years it takes to double your money. At 8% return, your investment roughly doubles in 9 years.' },
];
---

<CalculatorShell calculator={calculator} faqs={faqs}>
  <div slot="calculator">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
      <div>
        <label for="ci-principal" class="block text-sm font-medium text-surface-800 mb-1.5">Principal Amount ($)</label>
        <input type="number" id="ci-principal" value="5000" min="0" step="100" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ci-rate" class="block text-sm font-medium text-surface-800 mb-1.5">Annual Interest Rate (%)</label>
        <input type="number" id="ci-rate" value="8" min="0" max="50" step="0.1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ci-years" class="block text-sm font-medium text-surface-800 mb-1.5">Time Period (Years)</label>
        <input type="number" id="ci-years" value="15" min="1" max="50" step="1" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" />
      </div>
      <div>
        <label for="ci-frequency" class="block text-sm font-medium text-surface-800 mb-1.5">Compounding Frequency</label>
        <select id="ci-frequency" class="w-full rounded-lg border border-surface-200 px-4 py-2.5" aria-label="Compounding frequency per year">
          <option value="1">Annually</option>
          <option value="4">Quarterly</option>
          <option value="12" selected>Monthly</option>
          <option value="365">Daily</option>
        </select>
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="region" aria-live="polite" aria-label="Compound interest results">
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Compound Amount</p>
        <p id="ci-compound" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Simple Interest Amount</p>
        <p id="ci-simple" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Compound Interest Earned</p>
        <p id="ci-earned" class="text-xl font-bold text-brand-800">—</p>
      </div>
      <div class="rounded-lg bg-brand-50 border border-brand-100 p-4">
        <p class="text-sm text-surface-600">Compounding Advantage</p>
        <p id="ci-advantage" class="text-xl font-bold text-brand-800">—</p>
      </div>
    </div>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, compoundInterest, simpleInterest } from '@/utils/finance';

  const ids = ['ci-principal', 'ci-rate', 'ci-years', 'ci-frequency'];

  function calc() {
    const principal = parseFloat((document.getElementById('ci-principal') as HTMLInputElement)?.value) || 0;
    const rate = parseFloat((document.getElementById('ci-rate') as HTMLInputElement)?.value) || 0;
    const years = parseFloat((document.getElementById('ci-years') as HTMLInputElement)?.value) || 0;
    const freq = parseInt((document.getElementById('ci-frequency') as HTMLSelectElement)?.value) || 12;
    const compound = compoundInterest(principal, rate, years, freq);
    const simple = simpleInterest(principal, rate, years);
    (document.getElementById('ci-compound') as HTMLElement).textContent = formatCurrency(compound);
    (document.getElementById('ci-simple') as HTMLElement).textContent = formatCurrency(simple);
    (document.getElementById('ci-earned') as HTMLElement).textContent = formatCurrency(compound - principal);
    (document.getElementById('ci-advantage') as HTMLElement).textContent = formatCurrency(compound - simple);
  }

  calc();
  ids.forEach((id) => document.getElementById(id)?.addEventListener('input', calc));
  document.getElementById('ci-frequency')?.addEventListener('change', calc);
</script>
