---
import { siteConfig } from '@/data/site';
import { categories } from '@/data/categories';
import { calculators } from '@/data/calculators';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/learn', label: 'Learn' },
  { href: '/calculators', label: 'Calculators' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const learnCategories = categories.slice(0, 6);
---

<header class="sticky top-0 z-40 border-b border-surface-200 bg-white/95 backdrop-blur-sm">
  <div class="container-main">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label={`${siteConfig.name} home`}>
        <img src="/images/brand/logo.svg" alt="" width="160" height="40" class="h-8 w-auto" loading="eager" />
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        <div class="relative group">
          <button
            class="flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100 hover:text-brand-600"
            aria-expanded="false"
            aria-haspopup="true"
            id="learn-menu-btn"
          >
            Learn
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all absolute left-0 top-full pt-2 w-72">
            <div class="rounded-xl border border-surface-200 bg-white p-3 shadow-card-hover">
              {learnCategories.map((cat) => (
                <a
                  href={`/category/${cat.slug}`}
                  class="block rounded-lg px-3 py-2 text-sm text-surface-800 hover:bg-brand-50 hover:text-brand-700"
                >
                  {cat.name}
                </a>
              ))}
              <a href="/learn" class="block rounded-lg px-3 py-2 text-sm font-semibold text-brand-600 hover:bg-brand-50">
                View all categories →
              </a>
            </div>
          </div>
        </div>

        <div class="relative group">
          <button
            class="flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100 hover:text-brand-600"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Calculators
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all absolute left-0 top-full pt-2 w-72">
            <div class="rounded-xl border border-surface-200 bg-white p-3 shadow-card-hover max-h-80 overflow-y-auto">
              {calculators.slice(0, 8).map((calc) => (
                <a
                  href={`/calculators/${calc.slug}`}
                  class="block rounded-lg px-3 py-2 text-sm text-surface-800 hover:bg-brand-50 hover:text-brand-700"
                >
                  {calc.name}
                </a>
              ))}
              <a href="/calculators" class="block rounded-lg px-3 py-2 text-sm font-semibold text-brand-600 hover:bg-brand-50">
                All calculators →
              </a>
            </div>
          </div>
        </div>

        {navLinks.slice(2).map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              currentPath === link.href
                ? 'bg-brand-50 text-brand-700'
                : 'text-surface-800 hover:bg-surface-100 hover:text-brand-600',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href="/search" class="rounded-lg p-2 text-surface-800 hover:bg-surface-100 hover:text-brand-600" aria-label="Search">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>
        <a href="/learn" class="hidden sm:inline-flex btn-primary text-sm">Start Learning</a>
        <button
          id="mobile-menu-btn"
          class="lg:hidden rounded-lg p-2 text-surface-800 hover:bg-surface-100"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden lg:hidden border-t border-surface-200 bg-white" aria-label="Mobile navigation">
    <div class="container-main py-4 space-y-1">
      <a href="/learn" class="block rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100">Learn</a>
      <a href="/calculators" class="block rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100">Calculators</a>
      <a href="/about" class="block rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100">About</a>
      <a href="/contact" class="block rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100">Contact</a>
      <a href="/faq" class="block rounded-lg px-3 py-2 text-sm font-medium text-surface-800 hover:bg-surface-100">FAQ</a>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
