---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getAllArticlesSorted, toSearchEntries, ARTICLES_PER_PAGE } from '@/utils/articles';

const allArticles = await getAllArticlesSorted();
const searchData = toSearchEntries(allArticles);
const totalPages = Math.ceil(allArticles.length / ARTICLES_PER_PAGE);
---

<BaseLayout
  title="All Articles"
  description="Browse 100+ free educational articles on personal finance, investing, retirement, and wealth building."
  canonical="/learn"
>
  <div class="container-main py-8 lg:py-12">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'All Articles' },
    ]} />

    <header class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 mb-2">All Articles</h1>
        <p class="text-surface-800">{allArticles.length} expert-reviewed guides on personal finance and investing</p>
      </div>
      <a href="/search" class="btn-secondary shrink-0">Search Articles</a>
    </header>

    <div id="articles-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {allArticles.slice(0, ARTICLES_PER_PAGE).map((article) => <ArticleCard article={article} />)}
    </div>

    <nav id="pagination" class="mt-10 flex items-center justify-center gap-2" aria-label="Pagination"></nav>
  </div>

  <script define:vars={{ searchData, articlesPerPage: ARTICLES_PER_PAGE, totalPages }}>
    const grid = document.getElementById('articles-grid');
    const pagination = document.getElementById('pagination');
    const params = new URLSearchParams(window.location.search);
    let currentPage = Math.max(1, parseInt(params.get('page') || '1', 10));

    function renderCard(article) {
      const date = new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const categoryLabel = article.category.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
      return `
        <article class="card group h-full flex flex-col">
          <a href="/articles/${article.slug}" class="block overflow-hidden rounded-lg -mx-2 -mt-2 mb-4 aspect-video bg-surface-200">
            <img src="/images/articles/${article.slug}.svg" alt="" width="400" height="225" class="w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy" />
          </a>
          <div class="flex-1 flex flex-col">
            <div class="flex items-center gap-2 text-xs text-surface-800 mb-2">
              <a href="/category/${article.category}" class="font-medium text-brand-600 hover:underline">${categoryLabel}</a>
              <span>·</span>
              <span>${article.readingTime} min</span>
            </div>
            <h3 class="text-lg font-bold text-surface-900 mb-2 group-hover:text-brand-600 transition-colors">
              <a href="/articles/${article.slug}">${article.title}</a>
            </h3>
            <p class="text-sm text-surface-800 line-clamp-2 flex-1">${article.description}</p>
            <time datetime="${article.publishedAt}" class="mt-3 text-xs text-surface-300">${date}</time>
          </div>
        </article>
      `;
    }

    function pageHref(page) {
      return page === 1 ? '/learn' : `/learn?page=${page}`;
    }

    function renderPagination() {
      if (!pagination || totalPages <= 1) return;
      let html = '';
      html += currentPage > 1
        ? `<a href="${pageHref(currentPage - 1)}" class="btn-secondary text-sm px-4 py-2" rel="prev">← Previous</a>`
        : `<span class="btn-secondary text-sm px-4 py-2 opacity-40 pointer-events-none">← Previous</span>`;

      html += '<div class="flex items-center gap-1">';
      for (let p = 1; p <= totalPages; p++) {
        html += p === currentPage
          ? `<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-sm font-semibold text-white">${p}</span>`
          : `<a href="${pageHref(p)}" class="flex h-10 w-10 items-center justify-center rounded-lg text-sm font-medium text-surface-800 hover:bg-surface-100">${p}</a>`;
      }
      html += '</div>';

      html += currentPage < totalPages
        ? `<a href="${pageHref(currentPage + 1)}" class="btn-secondary text-sm px-4 py-2" rel="next">Next →</a>`
        : `<span class="btn-secondary text-sm px-4 py-2 opacity-40 pointer-events-none">Next →</span>`;

      pagination.innerHTML = html;
    }

    function renderPage(page) {
      currentPage = Math.min(Math.max(1, page), totalPages);
      const start = (currentPage - 1) * articlesPerPage;
      const items = searchData.slice(start, start + articlesPerPage);
      if (grid) grid.innerHTML = items.map(renderCard).join('');
      renderPagination();
      const url = currentPage === 1 ? '/learn' : `/learn?page=${currentPage}`;
      window.history.replaceState({}, '', url);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    if (currentPage > 1) renderPage(currentPage);
    else renderPagination();
  </script>
</BaseLayout>
