---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/site';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex={true}>
  <div class="container-main py-24 text-center">
    <p class="text-6xl font-bold text-brand-600 mb-4">404</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 mb-4">Page Not Found</h1>
    <p class="text-lg text-surface-800 mb-8 max-w-md mx-auto">
      Sorry, we couldn't find the page you're looking for. It may have been moved or removed.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">Go Home</a>
      <a href="/learn" class="btn-secondary">Browse Articles</a>
      <a href="/search" class="btn-secondary">Search</a>
    </div>
    <p class="mt-12 text-sm text-surface-800">
      Need help? <a href="/contact" class="text-brand-600 hover:underline">Contact us</a> or visit our <a href="/sitemap" class="text-brand-600 hover:underline">sitemap</a>.
    </p>
  </div>
</BaseLayout>
