---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getAllArticlesSorted, getAllTagSlugs, getArticlesByTag, getTagLabel, toSearchEntries, ARTICLES_PER_PAGE } from '@/utils/articles';

const allArticles = await getAllArticlesSorted();

export async function getStaticPaths() {
  const articles = await getAllArticlesSorted();
  const slugs = getAllTagSlugs(articles);
  return slugs.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const tagArticles = getArticlesByTag(allArticles, tag!);
const tagLabel = getTagLabel(allArticles, tag!);
const searchData = toSearchEntries(tagArticles);
const totalItems = tagArticles.length;
const totalPages = Math.ceil(totalItems / ARTICLES_PER_PAGE);
---

<BaseLayout
  title={`Articles tagged "${tagLabel}"`}
  description={`Browse ${totalItems} WealthHarbor articles about ${tagLabel}. Free educational finance content.`}
  canonical={`/tag/${tag}`}
>
  <div class="container-main py-8 lg:py-12">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Learn', href: '/learn' },
      { label: `Tag: ${tagLabel}` },
    ]} />

    <header class="mb-8">
      <p class="text-sm font-medium text-brand-600 mb-2">Topic Tag</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 mb-3">{tagLabel}</h1>
      <p class="text-surface-800">{totalItems} article{totalItems !== 1 ? 's' : ''} tagged with "{tagLabel}"</p>
    </header>

    <div id="articles-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tagArticles.slice(0, ARTICLES_PER_PAGE).map((article) => <ArticleCard article={article} />)}
    </div>

    <nav id="pagination" class="mt-10 flex items-center justify-center gap-2" aria-label="Pagination"></nav>
  </div>

  <script define:vars={{ searchData, articlesPerPage: ARTICLES_PER_PAGE, totalPages, basePath: `/tag/${tag}` }}>
    const grid = document.getElementById('articles-grid');
    const pagination = document.getElementById('pagination');
    const params = new URLSearchParams(window.location.search);
    let currentPage = Math.max(1, parseInt(params.get('page') || '1', 10));

    function renderCard(article) {
      const date = new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const categoryLabel = article.category.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
      return `<article class="card group h-full flex flex-col">
        <div class="flex-1 flex flex-col">
          <div class="flex items-center gap-2 text-xs text-surface-800 mb-2">
            <a href="/category/${article.category}" class="font-medium text-brand-600 hover:underline">${categoryLabel}</a>
            <span>·</span><span>${article.readingTime} min</span>
          </div>
          <h3 class="text-lg font-bold text-surface-900 mb-2 group-hover:text-brand-600 transition-colors">
            <a href="/articles/${article.slug}">${article.title}</a>
          </h3>
          <p class="text-sm text-surface-800 line-clamp-2 flex-1">${article.description}</p>
          <time datetime="${article.publishedAt}" class="mt-3 text-xs text-surface-300">${date}</time>
        </div>
      </article>`;
    }

    function pageHref(page) {
      return page === 1 ? basePath : `${basePath}?page=${page}`;
    }

    function renderPagination() {
      if (!pagination || totalPages <= 1) return;
      let html = currentPage > 1
        ? `<a href="${pageHref(currentPage - 1)}" class="btn-secondary text-sm px-4 py-2">← Previous</a>`
        : `<span class="btn-secondary text-sm px-4 py-2 opacity-40 pointer-events-none">← Previous</span>`;
      html += '<div class="flex items-center gap-1">';
      for (let p = 1; p <= totalPages; p++) {
        html += p === currentPage
          ? `<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-sm font-semibold text-white">${p}</span>`
          : `<a href="${pageHref(p)}" class="flex h-10 w-10 items-center justify-center rounded-lg text-sm font-medium text-surface-800 hover:bg-surface-100">${p}</a>`;
      }
      html += '</div>';
      html += currentPage < totalPages
        ? `<a href="${pageHref(currentPage + 1)}" class="btn-secondary text-sm px-4 py-2">Next →</a>`
        : `<span class="btn-secondary text-sm px-4 py-2 opacity-40 pointer-events-none">Next →</span>`;
      pagination.innerHTML = html;
    }

    function renderPage(page) {
      if (!grid) return;
      currentPage = Math.min(Math.max(1, page), totalPages);
      const start = (currentPage - 1) * articlesPerPage;
      grid.innerHTML = searchData.slice(start, start + articlesPerPage).map(renderCard).join('');
      renderPagination();
      window.history.replaceState({}, '', pageHref(currentPage));
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    if (currentPage > 1) renderPage(currentPage);
    else renderPagination();
  </script>
</BaseLayout>
