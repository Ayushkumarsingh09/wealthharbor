---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { calculators } from '@/data/calculators';

const categories = [...new Set(calculators.map((c) => c.category))];
---

<BaseLayout
  title="Free Financial Calculators"
  description="16 free financial calculators with formulas and explanations. SIP, EMI, mortgage, retirement, compound interest, and more."
  canonical="/calculators"
>
  <div class="container-main py-8 lg:py-12">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Calculators' },
    ]} />

    <header class="max-w-3xl mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 mb-4">Free Financial Calculators</h1>
      <p class="text-lg text-surface-800 leading-relaxed">
        Use our 16 educational calculators to model loans, investments, retirement savings, and trading scenarios.
        Each tool includes the underlying formula and a plain-language explanation.
      </p>
    </header>

    {categories.map((cat) => (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-surface-900 mb-4 capitalize">{cat}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {calculators.filter((c) => c.category === cat).map((calc) => (
            <a href={`/calculators/${calc.slug}`} class="card group hover:border-brand-300">
              <h3 class="font-bold text-surface-900 group-hover:text-brand-600 transition-colors">{calc.name}</h3>
              <p class="text-sm text-surface-800 mt-2">{calc.shortDescription}</p>
              <p class="mt-3 text-xs font-mono text-surface-300 truncate">{calc.formula}</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <strong>Educational Use Only:</strong> Calculator results are estimates for learning purposes. They do not account for taxes, fees, or market volatility unless noted. Consult a qualified professional before making financial decisions.
    </div>
  </div>
</BaseLayout>
