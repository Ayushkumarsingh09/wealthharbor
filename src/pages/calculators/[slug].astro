---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { calculators, getCalculatorBySlug } from '@/data/calculators';
import { buildTitle } from '@/utils/seo';
import SipCalculator from '@/components/calculators/SipCalculator.astro';
import LumpsumCalculator from '@/components/calculators/LumpsumCalculator.astro';
import EmiCalculator from '@/components/calculators/EmiCalculator.astro';
import LoanCalculator from '@/components/calculators/LoanCalculator.astro';
import MortgageCalculator from '@/components/calculators/MortgageCalculator.astro';
import CompoundInterestCalculator from '@/components/calculators/CompoundInterestCalculator.astro';
import RetirementCalculator from '@/components/calculators/RetirementCalculator.astro';
import InflationCalculator from '@/components/calculators/InflationCalculator.astro';
import CagrCalculator from '@/components/calculators/CagrCalculator.astro';
import PositionSizeCalculator from '@/components/calculators/PositionSizeCalculator.astro';
import RiskRewardCalculator from '@/components/calculators/RiskRewardCalculator.astro';
import MarginCalculator from '@/components/calculators/MarginCalculator.astro';
import OptionsProfitCalculator from '@/components/calculators/OptionsProfitCalculator.astro';
import BreakEvenCalculator from '@/components/calculators/BreakEvenCalculator.astro';
import FutureValueCalculator from '@/components/calculators/FutureValueCalculator.astro';
import PresentValueCalculator from '@/components/calculators/PresentValueCalculator.astro';
import SwpCalculator from '@/components/calculators/SwpCalculator.astro';

export function getStaticPaths() {
  return calculators.map((calc) => ({ params: { slug: calc.slug } }));
}

const { slug } = Astro.params;
const calculator = getCalculatorBySlug(slug!);

if (!calculator) {
  return Astro.redirect('/404');
}

const componentMap: Record<string, typeof SipCalculator> = {
  'sip-calculator': SipCalculator,
  'lumpsum-calculator': LumpsumCalculator,
  'emi-calculator': EmiCalculator,
  'loan-calculator': LoanCalculator,
  'mortgage-calculator': MortgageCalculator,
  'compound-interest-calculator': CompoundInterestCalculator,
  'retirement-calculator': RetirementCalculator,
  'inflation-calculator': InflationCalculator,
  'cagr-calculator': CagrCalculator,
  'position-size-calculator': PositionSizeCalculator,
  'risk-reward-calculator': RiskRewardCalculator,
  'margin-calculator': MarginCalculator,
  'options-profit-calculator': OptionsProfitCalculator,
  'break-even-calculator': BreakEvenCalculator,
  'future-value-calculator': FutureValueCalculator,
  'present-value-calculator': PresentValueCalculator,
  'swp-calculator': SwpCalculator,
};

const CalculatorComponent = componentMap[calculator.slug];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: calculator.name,
  description: calculator.description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title={buildTitle(calculator.name)}
  description={calculator.description}
  canonical={`/calculators/${calculator.slug}`}
  schema={schema}
>
  <div class="container-main py-8 lg:py-12">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Calculators', href: '/calculators' },
        { label: calculator.name },
      ]}
    />

    <header class="mb-8">
      <p class="text-sm font-medium text-brand-600 uppercase tracking-wide mb-2">{calculator.category}</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 text-balance">{calculator.name}</h1>
      <p class="mt-3 text-lg text-surface-700 max-w-3xl">{calculator.shortDescription}</p>
    </header>

    <div class="mt-8">
      <CalculatorComponent calculator={calculator} />
    </div>
  </div>
</BaseLayout>
