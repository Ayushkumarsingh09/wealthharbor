---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQSection from '@/components/FAQSection.astro';
import { getAuthorBySlug } from '@/data/authors';
import { getCategoryBySlug } from '@/data/categories';
import { formatDate } from '@/utils/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, category, author, reviewer, publishedAt, updatedAt, image, imageAlt, faqs, references } = article.data;
const { Content, headings } = await article.render();

const authorData = getAuthorBySlug(author);
const categoryData = getCategoryBySlug(category);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  canonical={`/articles/${article.slug}`}
  image={image}
  publishedAt={publishedAt.toISOString()}
  updatedAt={(updatedAt || publishedAt).toISOString()}
  author={authorData?.name}
>
  <article class="container-main py-8 lg:py-12">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Learn', href: '/learn' },
      { label: categoryData?.name || category, href: `/category/${category}` },
      { label: title },
    ]} />

    <header class="max-w-3xl mx-auto mb-8">
      <div class="flex flex-wrap items-center gap-3 text-sm text-surface-800 mb-4">
        <a href={`/category/${category}`} class="rounded-full bg-brand-50 px-3 py-1 font-medium text-brand-700 hover:bg-brand-100">
          {categoryData?.name}
        </a>
        <span>{article.data.readingTime} min read</span>
        <span>·</span>
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && (
          <>
            <span>·</span>
            <span>Updated {formatDate(updatedAt)}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-surface-900 text-balance mb-4">{title}</h1>
      <p class="text-lg text-surface-800 leading-relaxed">{description}</p>
      {authorData && (
        <div class="mt-6 flex items-center gap-4">
          <img src={authorData.image} alt="" width="48" height="48" class="rounded-full bg-surface-200" loading="lazy" />
          <div>
            <a href={`/authors/${author}`} class="font-semibold text-surface-900 hover:text-brand-600">{authorData.name}</a>
            <p class="text-sm text-surface-800">{authorData.role}</p>
          </div>
        </div>
      )}
    </header>

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12 max-w-6xl mx-auto">
      <div>
        <figure class="mb-8 rounded-xl overflow-hidden bg-surface-200 aspect-video">
          <img src={image} alt={imageAlt} width="800" height="450" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        </figure>

        {tocHeadings.length > 3 && (
          <nav class="card mb-8 lg:hidden" aria-label="Table of contents">
            <h2 class="font-semibold text-surface-900 mb-3">Table of Contents</h2>
            <ol class="space-y-2 text-sm">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'ml-4' : ''}>
                  <a href={`#${h.slug}`} class="text-brand-600 hover:underline">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="prose-content">
          <Content />
        </div>

        {references.length > 0 && (
          <section class="mt-12" aria-labelledby="references-heading">
            <h2 id="references-heading" class="text-xl font-bold text-surface-900 mb-4">References & Further Reading</h2>
            <ol class="space-y-2 text-sm">
              {references.map((ref, i) => (
                <li>
                  <a href={ref.url} class="text-brand-600 hover:underline" rel="noopener noreferrer" target="_blank">
                    {i + 1}. {ref.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        <div class="mt-8 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          <strong>Educational Disclaimer:</strong> This article is for educational purposes only and does not constitute financial advice. Consult a qualified professional before making financial decisions.
        </div>

        {faqs.length > 0 && <FAQSection faqs={faqs} />}
      </div>

      <aside class="hidden lg:block space-y-6">
        {tocHeadings.length > 3 && (
          <nav class="card sticky top-24" aria-label="Table of contents">
            <h2 class="font-semibold text-surface-900 mb-3">On This Page</h2>
            <ol class="space-y-2 text-sm">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'ml-3' : ''}>
                  <a href={`#${h.slug}`} class="text-surface-800 hover:text-brand-600 transition-colors">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>
